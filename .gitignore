# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# database backups (rotated by scripts/backup.mjs)
/backups

# Runtime user/payment/session data must never be published with application code.
/data/db/*.db
/data/db/*.db-wal
/data/db/*.db-shm
/data/db/*.db-journal

# typescript
*.tsbuildinfo
next-env.d.ts

# one-off script output
/fill.log
/fill.err
/sync.log

# SceneChain local browser evidence
/test-results/
/playwright-report/
/.refactor-evidence/
